          "name": "Jev first, GPT-6 Luna when Jev is unsure: cost for 30 findings",
          "value": 0.0012,
          "unitText": "USD"
        }
      ]
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": "#tool",
      "name": "simple-agent-collabs",
      "description": "A file-based research loop for one human and several LLM researchers, sharing a goal file and an append-only board. Jev makes the fast decisions: duplicate checks, model routing, evidence gating, and the stop check.",
      "programmingLanguage": "TypeScript",
      "runtimePlatform": [
        "Bun",
        "Node.js"
      ],
      "isBasedOn": {
        "@type": "SoftwareSourceCode",
        "name": "huggingface/agent-collabs",
        "codeRepository": "https://github.com/huggingface/agent-collabs"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "#jev",
      "name": "Jev",
      "applicationCategory": "AI decision model",
      "softwareVersion": "1.13",
      "description": "A System One model that returns typed decisions with probabilities instead of text.",
      "publisher": {
        "@type": "Organization",
        "name": "TypeSafe AI",
        "url": "https://typesafe.ai"
      },
      "offers": {
        "@type": "Offer",
        "price": "0.042",
        "priceCurrency": "USD",
        "description": "Per million input tokens; output tokens are free"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "#gate",
      "name": "finding gate",
      "description": "The check every research finding goes through before it is posted to the board. In simple-agent-collabs it has three steps: code checks that cited files, lines, and pages exist; Jev judges whether the cited passages back the whole claim; an LLM gives a second opinion when Jev is unsure. The original gate was one step: Jev reading only the citation text."
    }
