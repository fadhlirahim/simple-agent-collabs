  "@graph": [
    {
      "@type": "Report",
      "@id": "#report",
      "name": "Is Jev a better finding gate than an LLM judge?",
      "headline": "Jev first, LLM second: gating research findings",
      "abstract": "Jev on its own is not proven better than an LLM judge, but Jev first with an LLM second opinion beat either alone. Jev checks every finding against the fetched source text; when it is unsure, GPT-6 Luna decides. On 30 labeled findings it agreed with every label in one run, let no bad finding through, and cost $0.0012 for the set. One finding sat on the 0.5 cut-off, so the fair reading is 29 or 30 out of 30. The earlier gate, which showed Jev only the citation text, let 14 of 20 bad findings through.",
      "datePublished": "2026-09-24",
      "inLanguage": "en",
