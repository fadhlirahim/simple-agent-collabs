          "value": 28,
          "maxValue": 30
        },
        {
          "@type": "PropertyValue",
          "name": "GPT-6 Luna on fetched sources: agreement with labels",
          "value": 27,
          "maxValue": 30
        },
        {
          "@type": "PropertyValue",
          "name": "Jev first, GPT-6 Luna when Jev is unsure: agreement with labels",
          "value": 30,
          "maxValue": 30
        },
        {
          "@type": "PropertyValue",
          "name": "Old gate: Jev on citation text only: bad findings passed",
          "value": 14,
          "maxValue": 20
        },
        {
          "@type": "PropertyValue",
          "name": "Jev on fetched sources: bad findings passed",
          "value": 2,
          "maxValue": 20
        },
        {
          "@type": "PropertyValue",
          "name": "GPT-6 Luna on fetched sources: bad findings passed",
          "value": 1,
          "maxValue": 20
        },
        {
          "@type": "PropertyValue",
          "name": "Jev first, GPT-6 Luna when Jev is unsure: bad findings passed",
          "value": 0,
          "maxValue": 20
        },
        {
          "@type": "PropertyValue",
          "name": "Old gate: Jev on citation text only: cost for 30 findings",
          "value": 0.00059,
          "unitText": "USD"
        },
        {
          "@type": "PropertyValue",
